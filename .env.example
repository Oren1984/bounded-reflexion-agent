# Copy to .env (never commit .env).
# The Mock E2E demo and the test suite need none of these values.

# --- Model (only for live runs; this integration was not exercised in building the POC)
# Paid service: Anthropic API key from https://console.anthropic.com (billing must be enabled).
ANTHROPIC_API_KEY=
# The single model used for generation, reflection and repair.
BRA_MODEL=claude-haiku-4-5
# Optional. Leave empty for models that reject sampling parameters (e.g. Claude Opus 5.5).
BRA_TEMPERATURE=0

# --- Sandbox
BRA_SANDBOX_IMAGE=bra-sandbox:latest
BRA_SANDBOX_TIMEOUT_S=20

# --- LangSmith (optional; the demo uses a local Mock / Demo trace instead)
# Free Developer plan is sufficient: https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bounded-reflexion-agent
